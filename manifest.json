{
  "manifest_version": 3,
  "name": "NPTEL AI Solver",
  "version": "1.1.0",
  "description": "Autofills multiple-choice assignments on NPTEL Swayam using your own Gemini API key.",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "NPTEL AI Solver"
  }
}
